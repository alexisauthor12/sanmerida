roup relative flex items-center gap-6 w-full text-left transition-all duration-300 opacity-100 scale-100\"><div class=\"relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border transition-all duration-500 border-white bg-white text-black\"><svg class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"1.5\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"></path></svg></div><div class=\"flex flex-col\"><span class=\"text-xs font-mono tracking-widest transition-colors text-white/60\">PASO <!-- -->01</span><span class=\"text-lg font-light tracking-wide transition-colors text-white\">CONTACTO INICIAL</span></div><div class=\"absolute right-0 text-white/10 hidden lg:block\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\"><path d=\"M5 12h14M12 5l7 7-7 7\"></path></svg></div><div class=\"absolute bottom-[-10px] left-16 h-[2px] bg-white/20 w-32 rounded overflow-hidden\"><div class=\"h-full bg-white animate-[progress_6s_linear_infinite]\"></div></div></button><button class=\"group relative flex items-center gap-6 w-full text-left transition-all duration-300 opacity-40 hover:opacity-70 scale-95\"><div class=\"relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border transition-all duration-500 border-white/20 bg-black text-white\"><svg class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"1.5\" d=\"M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"></path></svg></div><div class=\"flex flex-col\"><span class=\"text-xs font-mono tracking-