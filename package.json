    "supabase:functions:serve": "npx supabase functions serve --env-file .env"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.16.2",
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.56.0",
