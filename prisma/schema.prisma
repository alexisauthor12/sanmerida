generator client {
  provider      = "prisma-client-js"
  engineType    = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  nombre         String
  apellido       String
  email          String   @unique
  telefono       String
  passwordHash   String
  isMember       Boolean  @default(false)
  memberProfile  MemberProfile?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum MemberAssetType {
  DOCUMENT
  CONTRACT
}

enum MemberAssetVariant {
  NORMAL
  SCANNED
}

model MemberProfile {
  id                String        @id @default(cuid())
  cedula            String        @unique
  operationalGroup  String?
  userId            String?       @unique
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  nombre            String?
  apellido          String?
  email             String?
  telefono          String?
  direccion         String?
  ocupacion         String?
  empresa           String?
  username          String?       @unique
  // Credenciales del miembro guardadas en el expediente: la clave
  // SAN-MEMBER-XXXXXX se almacena cifrada (AES-256-GCM) para que el
  // administrador pueda consultarla. El login sigue usando el hash bcrypt
  // del User.passwordHash.
  memberKeyCipher   String?
  memberKeyIssuedAt DateTime?
  motoSlug          String?
  motoMarca         String?
  motoModelo        String?
  motoImagen        String?
  motoUnitPrice     Float?
  // Numero de cuotas exacto del plan contratado (obligatorio para el plan de
  // financiamiento, donde la duracion depende del modelo de moto).
  installmentCount  Int?
  contractType      String?
  planName          String?
  termMonths        Int?
  monthlyAmount     Float?
  contractStartDate String?
  paymentMethod     String?
  paymentBank       String?
  paymentReference  String?
  paymentAmount     Float?
  paymentDate       String?
  references        String?
  ubicacionLat      Float?
  ubicacionLng      Float?
  ubicacionLink     String?
  referenciaLat     Float?
  referenciaLng     Float?
  referenciaLink    String?
  referencia2Lat    Float?
  referencia2Lng    Float?
  referencia2Link   String?
  assets            MemberAsset[]
  installmentPayments InstallmentPayment[]
  advancePayments   AdvancePayment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model MemberAsset {
  id         String             @id @default(cuid())
  profileId  String
  profile    MemberProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assetType  MemberAssetType
  documentKey String
  variant    MemberAssetVariant
  filePath   String
  fileName   String
  mimeType   String
  size       Int
  createdAt  DateTime           @default(now())

  @@index([profileId, assetType, documentKey, variant])
  @@unique([profileId, assetType, documentKey, variant])
}

model InstallmentPayment {
  id               String        @id @default(cuid())
  profileId        String
  profile          MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount           Float
  paymentDate      DateTime
  reference        String
  bank             String
  method           String
  note             String?
  createdByUserId  String?
  createdAt        DateTime      @default(now())

  @@index([profileId, installmentNumber])
  @@index([profileId, paymentDate])
}

model AdvancePayment {
  id              String        @id @default(cuid())
  profileId       String
  profile         MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amount          Float
  paymentDate     DateTime
  reference       String
  bank            String
  method          String
  note            String?
  createdByUserId String?
  createdAt       DateTime      @default(now())

  @@index([profileId, paymentDate])
}

/// Configuracion del plan de financiamiento (50% inicial + cuotas quincenales)
/// por modelo de moto. El administrador edita el numero de cuotas y el monto de
/// cada cuota a mano para cada modelo.
model MotoFinancing {
  id                String   @id @default(cuid())
  motoSlug          String   @unique
  motoNombre        String
  precioBase        Float?
  porcentajeInicial Float    @default(50)
  cuotasQuincenales Int      @default(12)
  montoCuota        Float?
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
