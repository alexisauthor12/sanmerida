generator client {
  provider      = "prisma-client-js"
  engineType    = "client"
}

datasource db {
  provider = "postgresql"
  // `url`: conexion de la aplicacion (pooler de transacciones, puerto 6543).
  url      = env("DATABASE_URL")
  // `directUrl`: SOLO para comandos de esquema (`db push` / `migrate`), que
  // necesitan el pooler de SESION (puerto 5432): el de transacciones no soporta
  // DDL y `prisma db push` se queda colgado con el.
  directUrl = env("DIRECT_URL")
}

/// Rol efectivo de una cuenta. No existe un rol OPERATOR: todo el personal es
/// ADMIN (ver docs/SEGURIDAD_INTEGRAL.md 13.2).
enum UserRole {
  /// Registro inicial publico (`/register`): catalogo, precios y feed publicado.
  /// NUNCA accede a expedientes, documentos ni cuotas de nadie.
  PROSPECT
  /// Miembro oficial con expediente: solo lo suyo.
  MEMBER
  /// Unico rol con poder. Opera con licencia administrativa (step-up).
  ADMIN
}

/// Acciones auditables (docs/SEGURIDAD_INTEGRAL.md seccion 6).
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  ADMIN_LICENSE_SUCCESS
  ADMIN_LICENSE_FAILED
  EXPEDIENTE_READ
  EXPEDIENTE_CREATE
  EXPEDIENTE_UPDATE
  EXPEDIENTE_DELETE
  DOCUMENTO_READ
  DOCUMENTO_UPLOAD
  DOCUMENTO_SCAN
  DOCUMENTO_DELETE
  CREDENCIAL_READ
  CREDENCIAL_ROTATE
  CUOTA_PAYMENT_REGISTER
  CUOTA_PAYMENT_REVERT
  FINANCIAMIENTO_UPDATE
  NOVEDAD_CREATE
  NOVEDAD_UPDATE
  NOVEDAD_DELETE
  GRUPO_EXPORT
  RATE_LIMIT_BLOCK
  /// El guard denego el acceso (permiso insuficiente o recurso ajeno).
  ACCESS_DENIED

  /// Segundo factor (TOTP).
  TOTP_ENABLED
  TOTP_DISABLED
  /// El usuario presento un codigo TOTP incorrecto.
  TOTP_CHALLENGE_FAILED
  /// Se consumio un codigo de recuperacion de un solo uso.
  RECOVERY_CODE_USED

  /// Resumen de una purga por retencion (`scripts/purge-audit-log.mjs`). Estas
  /// filas son **permanentes**: la purga nunca las borra, para que quede rastro de
  /// que la limpieza se hizo y de cuanto se borro.
  AUDIT_PURGE
}

model User {
  id             String   @id @default(cuid())
  nombre         String
  apellido       String
  email          String   @unique
  telefono       String
  passwordHash   String

  /// Rol efectivo del sistema. Sustituye a `isMember` como fuente de verdad.
  role           UserRole @default(PROSPECT)

  /// Compatibilidad temporal con el codigo existente: se mantiene sincronizado
  /// con `role` (MEMBER => true) hasta la Fase 2.
  isMember       Boolean  @default(false)

  /// Revocacion de sesiones: el JWT lleva este valor y se compara contra la base
  /// de datos en cada peticion. Incrementarlo invalida todas las sesiones.
  tokenVersion   Int      @default(1)

  /// Anti fuerza bruta y trazabilidad de acceso.
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  passwordChangedAt DateTime?

  /// Segundo factor (TOTP, RFC 6238). El secreto se guarda en base32; mientras
  /// `totpEnabled` sea false esta pendiente de confirmar (el usuario lo genero
  /// pero todavia no probo un codigo valido).
  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  totpConfirmedAt DateTime?

  /// Codigos de recuperacion de un solo uso, guardados como hash SHA-256 (nunca
  /// en claro). Al usarse uno se elimina de la lista. Son la salida de emergencia
  /// si el usuario pierde el dispositivo; sin ellos un ADMIN quedaria bloqueado.
  totpRecoveryCodes Json?

  memberProfile  MemberProfile?
  auditLogs      AuditLog[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum MemberAssetType {
  DOCUMENT
  CONTRACT
}

enum MemberAssetVariant {
  NORMAL
  SCANNED
}

model MemberProfile {
  id                String        @id @default(cuid())
  cedula            String        @unique
  operationalGroup  String?
  userId            String?       @unique
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  nombre            String?
  apellido          String?
  email             String?
  telefono          String?
  direccion         String?
  ocupacion         String?
  empresa           String?
  username          String?       @unique
  // Credenciales del miembro guardadas en el expediente: la clave
  // SAN-MEMBER-XXXXXX se almacena cifrada (AES-256-GCM) para que el
  // administrador pueda consultarla. El login sigue usando el hash bcrypt
  // del User.passwordHash.
  memberKeyCipher   String?
  memberKeyIssuedAt DateTime?
  motoSlug          String?
  motoMarca         String?
  motoModelo        String?
  motoImagen        String?
  motoUnitPrice     Float?
  // Numero de cuotas exacto del plan contratado (obligatorio para el plan de
  // financiamiento, donde la duracion depende del modelo de moto).
  installmentCount  Int?
  contractType      String?
  planName          String?
  termMonths        Int?
  monthlyAmount     Float?
  contractStartDate String?
  paymentMethod     String?
  paymentBank       String?
  paymentReference  String?
  paymentAmount     Float?
  paymentDate       String?
  references        String?
  ubicacionLat      Float?
  ubicacionLng      Float?
  ubicacionLink     String?
  referenciaLat     Float?
  referenciaLng     Float?
  referenciaLink    String?
  referencia2Lat    Float?
  referencia2Lng    Float?
  referencia2Link   String?
  assets            MemberAsset[]
  installmentPayments InstallmentPayment[]
  advancePayments   AdvancePayment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model MemberAsset {
  id         String             @id @default(cuid())
  profileId  String
  profile    MemberProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assetType  MemberAssetType
  documentKey String
  variant    MemberAssetVariant
  filePath   String
  fileName   String
  mimeType   String
  size       Int
  createdAt  DateTime           @default(now())

  @@index([profileId, assetType, documentKey, variant])
  @@unique([profileId, assetType, documentKey, variant])
}

model InstallmentPayment {
  id               String        @id @default(cuid())
  profileId        String
  profile          MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount           Float
  paymentDate      DateTime
  reference        String
  bank             String
  method           String
  note             String?
  createdByUserId  String?
  createdAt        DateTime      @default(now())

  @@index([profileId, installmentNumber])
  @@index([profileId, paymentDate])
}

model AdvancePayment {
  id              String        @id @default(cuid())
  profileId       String
  profile         MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amount          Float
  paymentDate     DateTime
  reference       String
  bank            String
  method          String
  note            String?
  createdByUserId String?
  createdAt       DateTime      @default(now())

  @@index([profileId, paymentDate])
}

/// Configuracion del plan de financiamiento (50% inicial + cuotas quincenales)
/// por modelo de moto. El administrador edita el numero de cuotas y el monto de
/// cada cuota a mano para cada modelo.

/// Publicaciones del feed de la empresa (noticias y videos) que ven los miembros
/// en su panel. Las administra el equipo desde el panel admin.
model NewsPost {
  id               String   @id @default(cuid())
  titulo           String
  resumen          String?
  contenido        String?
  categoria        String   @default("Corporativo")
  imagenUrl        String?
  videoUrl         String?
  autor            String?
  destacado        Boolean  @default(false)
  publicado        Boolean  @default(true)
  fechaPublicacion DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([publicado, fechaPublicacion])
}

model MotoFinancing {
  id                String   @id @default(cuid())
  motoSlug          String   @unique
  motoNombre        String
  precioBase        Float?
  porcentajeInicial Float    @default(50)
  cuotasQuincenales Int      @default(12)
  montoCuota        Float?
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Registro de auditoria: quien hizo que, sobre que, cuando y desde donde.
///
/// La aplicacion SOLO inserta (nunca actualiza ni borra filas individuales). La
/// limpieza se hace por retencion con `scripts/purge-audit-log.mjs`.
///
/// Nunca se guardan datos sensibles en claro: la cedula va enmascarada en
/// `targetLabel` (ver docs/SEGURIDAD_INTEGRAL.md 6.3).
model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction

  /// Quien lo hizo. `actorEmail` queda "congelado" para que el registro siga
  /// siendo legible aunque la cuenta se elimine despues (onDelete: SetNull).
  actorUserId String?
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?
  actorRole   String?

  /// Sobre que se hizo: "MemberProfile" | "MemberAsset" | "InstallmentPayment" | ...
  targetType  String?
  targetId    String?
  targetLabel String?

  /// Detalle NO sensible. Se rechazan claves como password, memberKey o token.
  metadata    Json?

  ip          String?
  userAgent   String?

  success     Boolean     @default(true)
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}
