generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  nombre         String
  apellido       String
  email          String   @unique
  telefono       String
  passwordHash   String
  isMember       Boolean  @default(false)
  memberProfile  MemberProfile?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum MemberAssetType {
  DOCUMENT
  CONTRACT
}

enum MemberAssetVariant {
  NORMAL
  SCANNED
}

model MemberProfile {
  id                String        @id @default(cuid())
  cedula            String        @unique
  operationalGroup  String?
  userId            String?       @unique
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  nombre            String?
  apellido          String?
  email             String?
  telefono          String?
  direccion         String?
  ocupacion         String?
  empresa           String?
  username          String?       @unique
  motoSlug          String?
  motoMarca         String?
  motoModelo        String?
  motoImagen        String?
  motoUnitPrice     Float?
  contractType      String?
  planName          String?
  termMonths        Int?
  monthlyAmount     Float?
  contractStartDate String?
  paymentMethod     String?
  paymentBank       String?
  paymentReference  String?
  paymentAmount     Float?
  paymentDate       String?
  references        String?
  assets            MemberAsset[]
  installmentPayments InstallmentPayment[]
  advancePayments   AdvancePayment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model MemberAsset {
  id         String             @id @default(cuid())
  profileId  String
  profile    MemberProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assetType  MemberAssetType
  documentKey String
  variant    MemberAssetVariant
  filePath   String
  fileName   String
  mimeType   String
  size       Int
  createdAt  DateTime           @default(now())

  @@index([profileId, assetType, documentKey, variant])
  @@unique([profileId, assetType, documentKey, variant])
}

model InstallmentPayment {
  id               String        @id @default(cuid())
  profileId        String
  profile          MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount           Float
  paymentDate      DateTime
  reference        String
  bank             String
  method           String
  note             String?
  createdByUserId  String?
  createdAt        DateTime      @default(now())

  @@index([profileId, installmentNumber])
  @@index([profileId, paymentDate])
}

model AdvancePayment {
  id              String        @id @default(cuid())
  profileId       String
  profile         MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amount          Float
  paymentDate     DateTime
  reference       String
  bank            String
  method          String
  note            String?
  createdByUserId String?
  createdAt       DateTime      @default(now())

  @@index([profileId, paymentDate])
}
